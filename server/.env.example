# Server runtime
PORT=8080
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://mangrov:mangrov@localhost:5432/mangrov

# Better Auth
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:5173

# Cookie domain (empty in dev — same site; in prod set to .mangrov.org for cross-subdomain auth)
COOKIE_DOMAIN=

# S3-compatible storage (Railway bucket in prod, MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mangrov-images
S3_PUBLIC_URL=http://localhost:9000/mangrov-images
S3_FORCE_PATH_STYLE=true
